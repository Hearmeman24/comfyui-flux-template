      "widgets_values": [
        "{\n  \"scene\": \"A sun-drenched outdoor terracotta tiled patio. The ground is covered in weathered, reddish-brown square terracotta pavers with visible grout lines and fine textures of dirt and sand. In the background, there are blurred potted plants and the edge of a stucco wall under a bright sky.\",\n  \"subjects\": [\n    {\n      \"description\": \"The young woman with long dark hair from image_0.png, with a tan complexion. She is wearing a matching 'digital lavender' (pale, slightly desaturated purple) bikini set consisting of a ruched bandeau top and high-waisted bottoms. The fabric clearly shows a textured weave. Her skin is detailed with visible pores and texture from the high-resolution capture.\",\n      \"pose\": \"Seated cross-legged directly on the patio tiles. She is looking down into the camera lens with a confident, direct gaze and a slight smile. Her hands rest near her lap.\",\n      \"position\": \"Centered in the frame, seated on the ground plane.\",\n      \"color_palette\": [\n        \"#B57EDC\",\n        \"#A05D42\",\n        \"#C58C6D\",\n        \"#8A5A44\"\n      ]\n    }\n  ],\n  \"style\": \"Sharp, modern smartphone photograph (e.g., iPhone or Pixel). High resolution, vibrant colors, precise details in texture and lighting. No vintage artifacts or date stamp.\",\n  \"lighting\": \"Harsh, direct midday sunlight. High contrast with bright, defined highlights on her skin and the bikini fabric, and deep, sharp shadows cast on the patio tiles.\",\n  \"camera\": {\n    \"angle\": \"Low angle, looking up at the seated subject from near ground level, typical of a phone being held low.\",\n    \"focal_length\": \"26mm equivalent (wide-angle smartphone lens)\",\n    \"f_stop\": \"f/1.8\",\n    \"focus\": \"Sharp focus on the subject's face and the textured bikini, with a shallow depth of field blurring the background patio.\"\n  },\n  \"color_palette\": [\n    \"#A05D42\",\n    \"#B57EDC\",\n    \"#C58C6D\",\n    \"#FFD700\",\n    \"#808080\"\n  ]\n}"
